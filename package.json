{
    "name": "gripdistance",
    "version": "0.0.0",
    "scripts": {
        "start": "npm run start --prefix gripdistance-frontend",
        "install-frontend": "npm install --prefix gripdistance-frontend",
        "lint": "npm run lint --prefix gripdistance-frontend",
        "postinstall": "npm run install-frontend",
        "prebuild": "npm run clean-dist && npm run clean-target && npm run validate-manifest",
        "build-arm": "export ARCH=linux/arm64 && npm run build",
        "build": "npm run build-frontend",
        "postbuild": "npm run package",
        "build-frontend": "npm run build --prefix gripdistance-frontend",
        "prepackage": "mkdir -p dist && npm run copy-frontend && npm run copy-manifest && npm run copy-license && npm run write-sbom",
        "package": "package-urcap dist target",
        "copy-frontend": "ncp 'gripdistance-frontend/dist' 'dist'",
        "copy-manifest": "ncp 'manifest.yaml' 'dist/manifest.yaml'",
        "write-sbom": "npm run write-sbom-frontend",
        "write-sbom-frontend": "write-ur-packages ./gripdistance-frontend/package-lock.json dist",
        "copy-license": "ncp 'LICENSE' 'dist/LICENSE'",
        "clean-dist": "rimraf ./dist",
        "clean-target": "rimraf ./target",
        "install-urcap": "install-urcap 'target/gripdistance*.urcapx' '../../manifest-spec-19.15.17.json'",
        "delete-urcap": "delete-urcap universal-robots gripdistance",
        "validate-manifest": "validate-manifest 'manifest.yaml' '../../manifest-spec-19.15.17.json'"
    },
    "private": true,
    "licence": "Apache-2.0",
    "dependencies": {
        "@angular/animations": "21.0.8",
        "@angular/cdk": "21.0.6",
        "@angular/common": "21.0.8",
        "@angular/compiler": "21.0.8",
        "@angular/core": "21.0.8",
        "@angular/elements": "21.0.8",
        "@angular/platform-browser": "21.0.8",
        "@angular/platform-browser-dynamic": "21.0.8",
        "@angular/router": "21.0.8",
        "@ngx-translate/core": "17.0.0",
        "@universal-robots/ui-angular-components": "22.36.253",
        "ngx-translate-multi-http-loader": "20.0.0",
        "rxjs": "^7.3.0",
        "zone.js": "0.16.0"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "21.0.5",
        "@angular-eslint/builder": "~21.0.0",
        "@angular-eslint/eslint-plugin": "~21.0.0",
        "@angular-eslint/eslint-plugin-template": "~21.0.0",
        "@angular-eslint/schematics": "~21.0.0",
        "@angular-eslint/template-parser": "~21.0.0",
        "@angular/cli": "21.0.5",
        "@angular/compiler-cli": "21.0.8",
        "@angular/language-service": "21.0.8",
        "@types/jasmine": "~5.1.0",
        "@typescript-eslint/eslint-plugin": "7.18.0",
        "@typescript-eslint/parser": "7.18.0",
        "@universal-robots/contribution-api": "22.36.253",
        "@universal-robots/designtokens": "22.36.253",
        "@universal-robots/ui-models": "22.36.253",
        "@universal-robots/urcap-utils": "2.4.2",
        "@universal-robots/utilities-units": "22.36.253",
        "eslint": "8.57.0",
        "jasmine-core": "~5.1.0",
        "karma": "~6.4.0",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.0",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "ncp": "2.0.0",
        "ngx-build-plus": "^19.0.0",
        "typescript": "5.9.3"
    },
    "peerDependencies": {
        "domhandler": "5.0.3"
    }
}
